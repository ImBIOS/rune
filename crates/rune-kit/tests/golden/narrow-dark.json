{"path":"#0/#0/b3/i1/#1/b1/i0/#1/b0","role":"text","rect":[80.00,429.00,244.00,23.00],"fill":"#00000000","key":"b0","text":"A nested point with \u{202f}\u{202f}code\u{202f}\u{202f} in it.","color":"#fafafaff"},
{"path":"#0/#0/b4","role":"text","rect":[16.00,472.00,308.00,20.00],"fill":"#00000000","key":"b4","text":"The fix","color":"#fafafaff"},
{"path":"#0/#0/b5","role":"text","rect":[16.00,500.00,308.00,67.50],"fill":"#00000000","key":"b5","text":"Treat silence as failure. If no event or heartbeat arrives for 25 seconds, close the stream and reconnect with backoff:","color":"#fafafaff"},
{"path":"#0/#0/b6","role":"group","rect":[16.00,579.50,308.00,384.00],"fill":"#242424ff","key":"b6"},
{"path":"#0/#0/b6/#0","role":"text","rect":[28.00,591.50,284.00,360.00],"fill":"#00000000","text":"const QUIET_MS = 25_000\n\nfunction watchdog(stream: EventStream, reconnect: () => void) {\n  let timer = setTimeout(fire, QUIET_MS) // restarted on every message\n  function fire() {\n    stream.close()\n    reconnect()\n  }\n  stream.on(\"message\", () => {\n    clearTimeout(timer)\n    timer = setTimeout(fire, QUIET_MS)\n  })\n}","color":"#fafafaff"},
