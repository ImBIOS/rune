#!/usr/bin/env bash
# Installs a built binary as ~/Applications/NAME.app and relaunches it without the window
# blinking: the new bundle is built beside the running one, swapped in, started, and the old
# process quits only once the new one is up. With `rune_mac::remember_frame` in the app, the new
# window opens exactly where the old one was, so the swap is invisible.
#   scripts/mac-app --name Example --id com.example.app --exe example --bin target/release/example \
#     [--icon assets/icon.icns] [--scheme example] [--mic "WHY"] [--wait-idle SECS] [-- APP ARGS]
# `--scheme NAME` registers NAME:// links with macOS for the app (`App::on_open_url` takes them).
# `--mic "WHY"` lets the app record from the microphone; macOS shows WHY in its first-run prompt.
# For unattended rebuilds, `--wait-idle SECS` holds the swap while the app is frontmost and the
# keyboard or mouse was used in the last SECS seconds, and relaunches behind whatever is in front
# when the app isn't (`open -g` plus MAC_APP_QUIET for `rune_mac::launch`: winit activates an app
# at launch even under `open -g`, and a window manager that follows focus would follow it).
# A running copy that called `rune_mac::busy(true)` holds the swap until it calls `busy(false)`,
# for up to 15 minutes.
# MAC_APP_SIGN names a codesigning identity ("Developer ID Application: …") to sign with, so
# macOS remembers permission answers (microphone, say) across rebuilds; without it the bundle is
# signed ad hoc, which macOS treats as a new app each build.
set -euo pipefail
IDLE=""
SCHEME=""
MIC=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --name) NAME=$2; shift 2 ;;
    --id) ID=$2; shift 2 ;;
    --exe) EXE=$2; shift 2 ;;
    --bin) BIN=$2; shift 2 ;;
    --icon) ICON=$2; shift 2 ;;
    --wait-idle) IDLE=$2; shift 2 ;;
    --scheme) SCHEME=$2; shift 2 ;;
    --mic) MIC=$2; shift 2 ;;
    --) shift; break ;;
    *) echo "mac-app: unknown flag $1" >&2; exit 2 ;;
  esac
done
: "${NAME:?--name}" "${ID:?--id}" "${EXE:?--exe}" "${BIN:?--bin}"
test -x "$BIN" || { echo "mac-app: no binary at $BIN" >&2; exit 1; }
LIVE="$HOME/Applications/$NAME.app"
APP="$LIVE.new"
rm -rf "$APP"
# Fixed-string matching: names like "OpenCode (Rune)" are not regexes.
running() { ps -axo pid=,command= | awk -v exe="$LIVE/Contents/MacOS/$EXE" '{ pid = $1; sub(/^ *[0-9]+ /, ""); if (index($0, exe) == 1) print pid }'; }
front() { lsappinfo info -only bundleid "$(lsappinfo front)" 2>/dev/null | grep -qF "\"$ID\""; }
idle_s() { ioreg -c IOHIDSystem | awk '/HIDIdleTime/ {print int($NF/1000000000); exit}'; }
BUSY="$HOME/Library/Caches/mac-app/busy"
busy() { for pid in $(running); do [ -e "$BUSY/$pid" ] && return 0; done; return 1; }
OPEN=()
if [ -n "$IDLE" ]; then
  while front && [ "$(idle_s)" -lt "$IDLE" ]; do sleep 2; done
  front || OPEN=(-g --env MAC_APP_QUIET=1)
fi
for _ in $(seq 450); do busy || break; sleep 2; done
OLD=$(running)
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "$BIN" "$APP/Contents/MacOS/$EXE"
[ -n "${ICON:-}" ] && cp "$ICON" "$APP/Contents/Resources/icon.icns"
URLS=""
[ -n "$SCHEME" ] && URLS="<key>CFBundleURLTypes</key><array><dict><key>CFBundleURLName</key><string>$ID</string><key>CFBundleURLSchemes</key><array><string>$SCHEME</string></array></dict></array>"
MICS=""
[ -n "$MIC" ] && MICS="<key>NSMicrophoneUsageDescription</key><string>$MIC</string>"
cat > "$APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>$NAME</string>
  <key>CFBundleDisplayName</key><string>$NAME</string>
  <key>CFBundleIdentifier</key><string>$ID</string>
  <key>CFBundleExecutable</key><string>$EXE</string>
  <key>CFBundleIconFile</key><string>icon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.0.1</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSHighResolutionCapable</key><true/>
  $URLS
  $MICS
</dict></plist>
PLIST
if [ -n "${MAC_APP_SIGN:-}" ]; then
  codesign --force --sign "$MAC_APP_SIGN" "$APP" >/dev/null 2>&1 \
    || { echo "mac-app: couldn't sign with $MAC_APP_SIGN; signing ad hoc" >&2; codesign --force --sign - "$APP" >/dev/null 2>&1 || true; }
else
  codesign --force --sign - "$APP" >/dev/null 2>&1 || true
fi
# The old process keeps running from its moved copy until the new window is up.
rm -rf "$LIVE.old"
[ -d "$LIVE" ] && mv "$LIVE" "$LIVE.old"
mv "$APP" "$LIVE"
# Tell Launch Services about the new bundle now, so its links route here at once.
[ -n "$SCHEME" ] && /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$LIVE" >/dev/null 2>&1 || true
open -n ${OPEN[@]+"${OPEN[@]}"} "$LIVE" --args "$@"
if [ -n "$OLD" ]; then
  for _ in $(seq 40); do
    [ -n "$(running | grep -vxF "$OLD" || true)" ] && break
    sleep 0.05
  done
  sleep 0.6
  kill $OLD 2>/dev/null || true
fi
rm -rf "$LIVE.old"
echo "$LIVE"
